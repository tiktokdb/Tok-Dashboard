VITE_GOOGLE_CLIENT_ID=<your OAuth client ID>
VITE_GOOGLE_API_KEY=<your Google API key>
VITE_ALLOWLIST_SSID=<paid user allowlist spreadsheet ID>
VITE_STRIPE_LINK_MONTHLY=<Stripe monthly payment link URL>
VITE_STRIPE_LINK_YEARLY=<Stripe yearly payment link URL>
VITE_USAGE_ENDPOINT=<optional usage endpoint URL>
VITE_BILLING_API_BASE=<billing backend URL>

# Server-only values for server/. Do not expose these with VITE_ prefixes.
GOOGLE_CLIENT_ID=<same OAuth client ID used by the frontend>
GOOGLE_BILLING_SHEET_ID=<billing ledger spreadsheet ID>
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service account email>
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=<service account private key with escaped newlines>
STRIPE_SECRET_KEY=<Stripe test secret key for development>
STRIPE_WEBHOOK_SECRET=<Stripe webhook signing secret>
STRIPE_PORTAL_RETURN_URL=<TokBoard app URL to return to after billing portal>
ALLOWED_ORIGIN=<TokBoard frontend origin>
MONTHLY_PRICE_ID=<Stripe monthly price ID>
YEARLY_PRICE_ID=<Stripe yearly price ID>
RECONCILIATION_REPORT_PATH=<optional report output path>
